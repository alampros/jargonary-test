{
  "name": "company-glossary-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "watch": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "check": "npm run lint && npm run typecheck && npm run test",
    "lint": "biome check --error-on-warnings ../biome.json .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome check --write ../biome.json ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  }
}
