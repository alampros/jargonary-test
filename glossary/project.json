{
  "version": "1",
  "name": "Jargonary project terms",
  "entries": [
    {
      "id": "glossary",
      "term": "Glossary",
      "senses": [
        {
          "id": "project",
          "definition": "A collection of specialized words and their definitions specific to a context, such as a team, discipline, application, or body of work.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "The Engineering glossary defines API as the American Petroleum Institute; the Web Development glossary defines API as an application programming interface."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "dictionary"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "source"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "entry"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "export"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ],
      "pronunciation": "GLOSS-uh-ree"
    },
    {
      "id": "dictionary",
      "term": "Dictionary",
      "senses": [
        {
          "id": "project",
          "definition": "A comprehensive collection of words from an entire language, with their meanings and usage.",
          "context": "General language reference",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "An English dictionary covers vocabulary across the language; an engineering glossary focuses on specialized vocabulary within engineering."
          ],
          "partOfSpeech": "noun"
        }
      ],
      "pronunciation": "DIK-shuh-nair-ee"
    },
    {
      "id": "entry",
      "term": "Entry",
      "senses": [
        {
          "id": "project",
          "definition": "A record with a stable ID, a preferred term, optional aliases, and one or more senses. Its term text does not have to be unique.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "One Component entry has asset-management and frontend senses."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "term"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "sense"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "alias"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "term",
      "term": "Term",
      "senses": [
        {
          "id": "project",
          "definition": "A word or phrase used to name a concept. The term field is an entry's preferred display name; the same text may name different entries or meanings.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "Component is term text, not an identity key."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "entry"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "sense"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "stable-id"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "sense",
      "term": "Sense",
      "aliases": [
        {
          "text": "Meaning"
        }
      ],
      "senses": [
        {
          "id": "project",
          "definition": "One identifiable meaning within an entry, with its own definition and optional context, examples, tags, links, and relationships.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "The web-interface meaning of Component is one sense."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "entry"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "definition"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "context"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "definition",
      "term": "Definition",
      "senses": [
        {
          "id": "project",
          "definition": "The explanatory text of a sense. A definition describes a meaning; it is not the complete entry or sense record.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "A reusable web interface element is a definition."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "sense"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "alias",
      "term": "Alias",
      "senses": [
        {
          "id": "project",
          "definition": "An additional lookup name for an existing entry, optionally restricted to one of its senses. It has no independent definition and need not be globally unique.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "Application Programming Interface is an alias scoped to the software meaning of API in the Web Development glossary."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "entry"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "sense"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "abbreviation"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "abbreviation",
      "term": "Abbreviation",
      "senses": [
        {
          "id": "project",
          "definition": "A shortened form of another term. It may be an alias when it needs no independent definition, or a separate entry or sense connected by abbreviationOf.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "PI can be a separately defined abbreviation of Payment Intent."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "alias"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "relationship"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ],
      "pronunciation": "uh-bree-vee-AY-shun"
    },
    {
      "id": "context",
      "term": "Context",
      "senses": [
        {
          "id": "project",
          "definition": "Information that distinguishes where a sense applies, such as a department, discipline, or application.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "Frontend engineering distinguishes one meaning of Component."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "sense"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "tag"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "tag",
      "term": "Tag",
      "senses": [
        {
          "id": "project",
          "definition": "A label attached to a sense for organization and selection. Tags used by export selectors participate in publication decisions.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "A public tag can make a sense eligible for an explicitly configured export."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "sense"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "selector"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "stable-id",
      "term": "Stable ID",
      "aliases": [
        {
          "text": "Identifier"
        }
      ],
      "senses": [
        {
          "id": "project",
          "definition": "A reference key that remains unchanged when display text changes. Entry IDs are scoped to a source and sense IDs to an entry. Exports derive stable entry IDs from the original source and entry IDs.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "Renaming Payment Intent does not change its entry ID."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "source"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "reference"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "relationship",
      "term": "Relationship",
      "senses": [
        {
          "id": "project",
          "definition": "A typed connection from an entry or sense to another entry or sense. Reverse connections are derived where the relation defines an inverse.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "PI abbreviationOf Payment Intent is a relationship between independently identifiable records."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "reference"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "alias"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "reference",
      "term": "Reference",
      "senses": [
        {
          "id": "project",
          "definition": "Structured data identifying a relationship target by entry ID, optional sense ID, and optional source ID. An omitted source means the current source.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "A reference can select only the payments sense of PI."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "relationship"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "stable-id"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "unresolved-reference",
      "term": "Unresolved reference",
      "senses": [
        {
          "id": "project",
          "definition": "A reference whose target cannot be found in the current imported content. It produces a diagnostic, not removal of the originating definition.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "A replacement may remain unresolved while its source has not yet been imported."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "reference"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "deprecation"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "abbreviation-of",
      "term": "abbreviationOf",
      "senses": [
        {
          "id": "project",
          "definition": "A relationship stating that the originating entry or sense is a shortened form of the target. Its reverse relation is abbreviatedBy.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "PI abbreviationOf Payment Intent; Payment Intent abbreviatedBy PI."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "abbreviation"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "relationship"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "related-to",
      "term": "relatedTo",
      "senses": [
        {
          "id": "project",
          "definition": "A symmetric relationship associating two entries or senses without asserting that they have identical meanings.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "Asset component relatedTo Asset system."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "relationship"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "deprecated-for",
      "term": "deprecatedFor",
      "senses": [
        {
          "id": "project",
          "definition": "A relationship marking the originating entry or sense deprecated in favor of a replacement target. Its derived reverse relation is supersedes; a missing target does not remove deprecation.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "An old application name can be deprecatedFor its new name."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "deprecation"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "relationship"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "instance",
      "term": "Instance",
      "aliases": [
        {
          "text": "Installation"
        }
      ],
      "senses": [
        {
          "id": "project",
          "definition": "One deployed application with its own configuration, cached glossaries, serving endpoints, and optional exports.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "A private instance and a public instance are separate deployments."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "source"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "export"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "source",
      "term": "Source",
      "senses": [
        {
          "id": "project",
          "definition": "An operator-configured input identified by a stable local ID, read from a file or fetched from a URL, together with its format, schedule, and access settings. Source configuration is distinct from glossary content.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "payments is a configured source that fetches a JSON glossary from an internal application."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "glossary"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "target"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "snapshot"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "target",
      "term": "Target",
      "aliases": [
        {
          "text": "Scrape target"
        }
      ],
      "senses": [
        {
          "id": "project",
          "definition": "The concrete URL or file path read by a scraper for a source. It is a location, not the source identity or the glossary itself.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "https://payments.internal/.well-known/glossary is a target URL."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "source"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "scrape"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "scrape",
      "term": "Scrape",
      "senses": [
        {
          "id": "project",
          "definition": "One attempt to read a source and check its glossary. A fetch can succeed while parsing or validation fails; only a valid complete replacement changes published content.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "A scrape receiving malformed JSON fails and leaves the previous snapshot available."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "source"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "snapshot"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "synchronization"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "snapshot",
      "term": "Snapshot",
      "senses": [
        {
          "id": "project",
          "definition": "A complete validated version of a source glossary accepted for serving. A valid empty glossary is a snapshot; a failed read is not.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "A new snapshot replaces the source's previous entries atomically."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "glossary"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "last-successful-snapshot"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "last-successful-snapshot",
      "term": "Last successful snapshot",
      "senses": [
        {
          "id": "project",
          "definition": "The most recently accepted complete glossary for a source, retained indefinitely through failed scrapes and restarts until replaced or explicitly removed locally.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "Revoking an export credential does not erase a consumer's last successful snapshot."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "snapshot"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "deletion"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "stale-source"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "synchronization",
      "term": "Synchronization",
      "aliases": [
        {
          "text": "Sync"
        }
      ],
      "senses": [
        {
          "id": "project",
          "definition": "The process of scraping, validating, and atomically replacing a source snapshot and its derived search and relationship data.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "A successful sync applies additions, changes, and removals together."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "scrape"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "snapshot"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "stale-source",
      "term": "Stale source",
      "senses": [
        {
          "id": "project",
          "definition": "A source whose accepted content has not been successfully revalidated recently. Freshness describes synchronization health and does not mark its vocabulary deprecated or remove it.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "An unreachable source may be stale while its terms remain current and usable."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "last-successful-snapshot"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "deprecation"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "export",
      "term": "Export",
      "aliases": [
        {
          "text": "Named export"
        }
      ],
      "senses": [
        {
          "id": "project",
          "definition": "A configured, named publication of selected vocabulary as a glossary at a stable endpoint, with an explicit selector and access policy. A consumer treats that endpoint as an ordinary HTTP source.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "The public export includes approved senses from a private instance."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "glossary"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "selector"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "publisher"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "consumer"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "selector",
      "term": "Selector",
      "aliases": [
        {
          "text": "Inclusion selector"
        }
      ],
      "senses": [
        {
          "id": "project",
          "definition": "An operator-defined rule choosing which senses enter an export. Matching senses carry permitted entry metadata; relationships to excluded targets are pruned.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "sense_tags.any: [public] selects senses carrying the public tag."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "export"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "tag"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "withdrawal"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "publisher",
      "term": "Publisher",
      "senses": [
        {
          "id": "project",
          "definition": "The application or instance serving a glossary for another instance to scrape. Filtering an export happens here, before the consumer receives the content.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "A private instance publishes only its selected public vocabulary to a public consumer."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "consumer"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "export"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "consumer",
      "term": "Consumer",
      "senses": [
        {
          "id": "project",
          "definition": "An instance fetching a glossary into one of its configured sources. Permission to fetch an export does not grant access to the publisher's other routes.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "A public instance consumes an authenticated export from a private instance."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "publisher"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "source"
              }
            }
          ],
          "partOfSpeech": "noun"
        }
      ]
    },
    {
      "id": "deletion",
      "term": "Deletion",
      "senses": [
        {
          "id": "project",
          "definition": "Removal of content from a source's current glossary. Consumers apply the removal when a successful replacement snapshot omits it; fetch failures and missing endpoints are not deletion instructions.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
            "Removing a sense from a valid glossary deletes that sense at the next successful sync."
          ],
          "relationships": [
            {
              "type": "relatedTo",
              "target": {
                "entry": "withdrawal"
              }
            },
            {
              "type": "relatedTo",
              "target": {
                "entry": "deprecation"
              }
            },
            {
              "type": "relatedTo",
              "target": {
