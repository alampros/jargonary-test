          "text": "Admin UI"
        },
        {
          "text": "Debug UI"
        }
      ],
      "senses": [
        {
          "id": "project",
          "definition": "An optional operator interface on a separate listener, defaulting to port 9090 and disabled unless explicitly enabled. Initially read-only, it exposes redacted resolved configuration and detailed scrape diagnostics. Separate networking does not itself authenticate operators; future write tasks need an access-control design.",
          "context": "Project terminology",
          "tags": [
            "project-glossary"
          ],
          "examples": [
