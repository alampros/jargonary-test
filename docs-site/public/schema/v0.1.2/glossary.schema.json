{
  "$defs": {
    "Alias": {
      "additionalProperties": false,
      "properties": {
        "sense": {
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "Dictionary": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/Entry"
          },
          "type": "array"
        },
        "exported": {
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "enum": [
            "1"
          ],
          "type": "string"
        }
      },
      "required": [
        "version",
        "name",
        "entries"
      ],
      "type": "object"
    },
    "Entry": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "$ref": "#/$defs/Alias"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "deprecated": {
          "type": "boolean"
        },
        "deprecationReason": {
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Reference"
        },
        "pronunciation": {
          "type": "string"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "senses": {
          "items": {
            "$ref": "#/$defs/Sense"
          },
          "minItems": 1,
          "type": "array"
        },
        "term": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "term",
        "senses"
      ],
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "entry": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$",
          "type": "string"
        },
        "sense": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "entry"
      ],
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/Reference"
        },
        "type": {
          "enum": [
            "abbreviationOf",
            "relatedTo",
            "deprecatedFor"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "target"
      ],
      "type": "object"
    },
    "Sense": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "string"
        },
        "definition": {
          "minLength": 1,
          "type": "string"
        },
        "deprecated": {
          "type": "boolean"
        },
        "deprecationReason": {
          "type": "string"
        },
        "examples": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$",
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "partOfSpeech": {
          "type": "string"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "definition"
      ],
      "type": "object"
    }
  },
  "$id": "https://alampros.github.io/jargonary/schema/v0.1.2/glossary.schema.json",
  "$ref": "#/$defs/Dictionary",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
