{
  "name": "jargonary-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "watch": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "check": "npm run lint && npm run typecheck && npm run test",
    "lint": "biome check --error-on-warnings ../biome.json ../internal/themes .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome check --write ../biome.json ../internal/themes .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@mdxeditor/editor": "^4.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@uiw/react-codemirror": "^4.25.12",
    "ajv": "^8.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "30.1.3",
    "msw": "^3.0.3",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "latest",
    "storybook": "^10.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
